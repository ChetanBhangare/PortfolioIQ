{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPortfolioIQPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::portfolioiq-cb-data-2026",
      "Condition": {"StringLike": {"s3:prefix": ["portfolioiq", "portfolioiq/*"]}}
    },
    {
      "Sid": "ReadPortfolioIQObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::portfolioiq-cb-data-2026/portfolioiq/*"
    }
  ]
}
